{
  "$defs": {
    "FindingStatus": {
      "enum": [
        "categorized",
        "no_match_found",
        "citation_unclear",
        "not_enough_evidence",
        "pending",
        "processing_failed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "ReviewCorrection": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3,
                4
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        }
      },
      "required": [
        "status",
        "category"
      ],
      "title": "ReviewCorrection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "correction": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewCorrection"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "confirmed",
        "rejected",
        "corrected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "finding_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Finding Id",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "input_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Input Ids",
      "type": "array"
    },
    "kind": {
      "const": "review",
      "default": "review",
      "title": "Kind",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes_review_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Review Id"
    }
  },
  "required": [
    "id",
    "created_at",
    "analysis_run_id",
    "input_ids",
    "finding_id",
    "reviewer_id",
    "decision",
    "note",
    "correction"
  ],
  "title": "Review",
  "type": "object"
}
