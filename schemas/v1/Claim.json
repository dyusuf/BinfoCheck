{
  "$defs": {
    "SpanRef": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "exact_text": {
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "source_unit_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Unit Id"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Text Id",
          "type": "string"
        }
      },
      "required": [
        "text_id",
        "start",
        "end",
        "exact_text"
      ],
      "title": "SpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "claim_group_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Claim Group Id",
      "type": "string"
    },
    "context_unit_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Context Unit Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Decision Ids",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "input_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Input Ids",
      "type": "array"
    },
    "kind": {
      "const": "claim",
      "default": "claim",
      "title": "Kind",
      "type": "string"
    },
    "language": {
      "const": "de",
      "default": "de",
      "title": "Language",
      "type": "string"
    },
    "normalized_claim": {
      "minLength": 1,
      "title": "Normalized Claim",
      "type": "string"
    },
    "observation_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Observation Id",
      "type": "string"
    },
    "original_span": {
      "$ref": "#/$defs/SpanRef"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_at",
    "analysis_run_id",
    "input_ids",
    "observation_id",
    "normalized_claim",
    "original_span",
    "context_unit_ids",
    "decision_ids",
    "claim_group_id"
  ],
  "title": "Claim",
  "type": "object"
}
