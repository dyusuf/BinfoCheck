{
  "$defs": {
    "SpanRef": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "exact_text": {
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "source_unit_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Unit Id"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Text Id",
          "type": "string"
        }
      },
      "required": [
        "text_id",
        "start",
        "end",
        "exact_text"
      ],
      "title": "SpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "context_unit_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Context Unit Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Decision Ids",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "input_ids": {
      "items": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Input Ids",
      "type": "array"
    },
    "issue": {
      "enum": [
        "invalid",
        "unlocatable",
        "ambiguous",
        "unresolved",
        "excluded",
        "failed"
      ],
      "title": "Issue",
      "type": "string"
    },
    "kind": {
      "const": "extraction_issue",
      "default": "extraction_issue",
      "title": "Kind",
      "type": "string"
    },
    "observation_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Observation Id",
      "type": "string"
    },
    "original_span": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpanRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_claim": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Proposed Claim"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "created_at",
    "analysis_run_id",
    "input_ids",
    "observation_id",
    "issue",
    "reason",
    "proposed_claim",
    "original_span",
    "context_unit_ids",
    "decision_ids"
  ],
  "title": "ExtractionIssue",
  "type": "object"
}
