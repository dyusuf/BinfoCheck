{
  "$defs": {
    "IndexRef": {
      "additionalProperties": false,
      "properties": {
        "corpus_manifest_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Corpus Manifest Id",
          "type": "string"
        },
        "embedding_dimensions": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_model": {
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "lexical_settings": {
          "$ref": "#/$defs/Settings"
        },
        "version": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "id",
        "corpus_manifest_id",
        "version",
        "embedding_model",
        "embedding_dimensions",
        "lexical_settings"
      ],
      "title": "IndexRef",
      "type": "object"
    },
    "JsonValue": {},
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        },
        "version": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "version",
        "values"
      ],
      "title": "Settings",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_run_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "claim_id": {
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Claim Id",
      "type": "string"
    },
    "index": {
      "$ref": "#/$defs/IndexRef"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    }
  },
  "required": [
    "analysis_run_id",
    "claim_id",
    "settings",
    "index"
  ],
  "title": "RetrievalRequest",
  "type": "object"
}
