{
  "$defs": {
    "CandidatePair": {
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Run Id",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "context_passage_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Context Passage Ids",
          "type": "array"
        },
        "corpus_manifest_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Corpus Manifest Id",
          "type": "string"
        },
        "correspondence_decision_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Correspondence Decision Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "fused_rank": {
          "exclusiveMinimum": 0,
          "title": "Fused Rank",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "index_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Index Id",
          "type": "string"
        },
        "input_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Ids",
          "type": "array"
        },
        "kind": {
          "const": "candidate_pair",
          "default": "candidate_pair",
          "title": "Kind",
          "type": "string"
        },
        "passage_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Passage Id",
          "type": "string"
        },
        "path_ranks": {
          "items": {
            "$ref": "#/$defs/PathRank"
          },
          "minItems": 1,
          "title": "Path Ranks",
          "type": "array"
        },
        "retrieval_batch_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Retrieval Batch Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "verification_decision_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verification Decision Id"
        }
      },
      "required": [
        "id",
        "created_at",
        "analysis_run_id",
        "input_ids",
        "claim_id",
        "retrieval_batch_id",
        "corpus_manifest_id",
        "index_id",
        "passage_id",
        "path_ranks",
        "fused_rank",
        "context_passage_ids",
        "verification_decision_id",
        "correspondence_decision_id"
      ],
      "title": "CandidatePair",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "IndexRef": {
      "additionalProperties": false,
      "properties": {
        "corpus_manifest_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Corpus Manifest Id",
          "type": "string"
        },
        "embedding_dimensions": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_model": {
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "lexical_settings": {
          "$ref": "#/$defs/Settings"
        },
        "version": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "id",
        "corpus_manifest_id",
        "version",
        "embedding_model",
        "embedding_dimensions",
        "lexical_settings"
      ],
      "title": "IndexRef",
      "type": "object"
    },
    "JsonValue": {},
    "PathRank": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "semantic",
            "lexical"
          ],
          "title": "Path",
          "type": "string"
        },
        "rank": {
          "exclusiveMinimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "path",
        "rank",
        "score"
      ],
      "title": "PathRank",
      "type": "object"
    },
    "RetrievalBatch": {
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Run Id",
          "type": "string"
        },
        "candidate_pair_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Candidate Pair Ids",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "completion": {
          "enum": [
            "complete",
            "incomplete",
            "failed"
          ],
          "title": "Completion",
          "type": "string"
        },
        "corpus_manifest_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Corpus Manifest Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "index": {
          "$ref": "#/$defs/IndexRef"
        },
        "input_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Ids",
          "type": "array"
        },
        "kind": {
          "const": "retrieval_batch",
          "default": "retrieval_batch",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "truncation_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Truncation Reason"
        }
      },
      "required": [
        "id",
        "created_at",
        "analysis_run_id",
        "input_ids",
        "claim_id",
        "corpus_manifest_id",
        "index",
        "candidate_pair_ids",
        "completion",
        "truncation_reason",
        "settings"
      ],
      "title": "RetrievalBatch",
      "type": "object"
    },
    "RetrievalResult": {
      "additionalProperties": false,
      "properties": {
        "batch": {
          "$ref": "#/$defs/RetrievalBatch"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidatePair"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "batch",
        "candidates"
      ],
      "title": "RetrievalResult",
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        },
        "version": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "version",
        "values"
      ],
      "title": "Settings",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "value",
    "error"
  ],
  "title": "Outcome[RetrievalResult]",
  "type": "object"
}
