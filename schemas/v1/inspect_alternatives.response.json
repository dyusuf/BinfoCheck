{
  "$defs": {
    "AlternativeInspection": {
      "additionalProperties": false,
      "properties": {
        "analysis_run_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Run Id",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "correspondence": {
          "$ref": "#/$defs/CorrespondenceStatus"
        },
        "coverage": {
          "enum": [
            "assessable",
            "insufficient"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "coverage_reason": {
          "minLength": 1,
          "title": "Coverage Reason",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Id"
        },
        "duplicate_group": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duplicate Group"
        },
        "excerpt_text_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Excerpt Text Id"
        },
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "input_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Ids",
          "type": "array"
        },
        "kind": {
          "const": "alternative_inspection",
          "default": "alternative_inspection",
          "title": "Kind",
          "type": "string"
        },
        "observation_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_reference_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Reference Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "inspected",
            "unassessed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_at",
        "analysis_run_id",
        "input_ids",
        "observation_id",
        "claim_id",
        "source_reference_id",
        "excerpt_text_id",
        "state",
        "correspondence",
        "decision_id",
        "coverage",
        "coverage_reason",
        "duplicate_group"
      ],
      "title": "AlternativeInspection",
      "type": "object"
    },
    "CorrespondenceStatus": {
      "enum": [
        "match",
        "partial_match",
        "no_match",
        "uncertain",
        "not_assessed"
      ],
      "title": "CorrespondenceStatus",
      "type": "string"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AlternativeInspection"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "status",
    "value",
    "error"
  ],
  "title": "Outcome[tuple[AlternativeInspection, ...]]",
  "type": "object"
}
